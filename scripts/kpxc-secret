#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage:
  kpxc-secret clip ENTRY [FIELD] [TIMEOUT_SECONDS]
  kpxc-secret pipe ENTRY FIELD -- COMMAND [ARG...]

Environment:
  KPXC_DB              KeePassXC database path
  KPXC_KEY             KeePassXC key file path
  KPXC_SECRET_ACCOUNT  Secret Service account attribute
USAGE
}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

command -v secret-tool >/dev/null 2>&1 || fail "secret-tool is required"
command -v keepassxc-cli >/dev/null 2>&1 || fail "keepassxc-cli is required"

database_path="${KPXC_DB:-$HOME/.local/share/keepassxc/vault.kdbx}"
key_path="${KPXC_KEY:-$HOME/.keys/vault.keyx}"
secret_account="${KPXC_SECRET_ACCOUNT:-$(id -un)}"

[[ -r "$database_path" ]] || fail "KeePassXC database is not readable"
[[ -r "$key_path" ]] || fail "KeePassXC key file is not readable"

vault_password() {
  secret-tool lookup service keepassxc-vault account "$secret_account"
}

case "${1:-}" in
  clip)
    [[ $# -ge 2 && $# -le 4 ]] || {
      usage
      exit 2
    }

    entry_path="$2"
    field_name="${3:-Password}"
    timeout_seconds="${4:-20}"
    [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || fail "timeout must be a positive integer"

    vault_password |
      keepassxc-cli clip --quiet -k "$key_path" -a "$field_name" \
        "$database_path" "$entry_path" "$timeout_seconds"
    ;;
  pipe)
    [[ $# -ge 5 && "$4" == "--" ]] || {
      usage
      exit 2
    }

    entry_path="$2"
    field_name="$3"
    shift 4
    [[ $# -gt 0 ]] || fail "a receiving command is required"

    vault_password |
      keepassxc-cli show --quiet -k "$key_path" -a "$field_name" \
        "$database_path" "$entry_path" |
      "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac
